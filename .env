# =============================================================================
#  e-SAPS — environment TEMPLATE
#
#  Copy this file to ".env" and fill in real values:   cp .env.example .env
#  The real ".env" is git-ignored and must NEVER be committed.
#  Every value below is intentionally EMPTY — no secret lives in the repo.
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3005
APP_NAME=e-SAPS

# ── PostgreSQL ───────────────────────────────────────────────────────────────
#  Host and port are kept as SEPARATE variables so the exact same code runs in
#  every environment — you only change these values, never the code:
#
#    • Development (the API runs on your host machine):
#        POSTGRES_HOST=localhost
#        POSTGRES_PORT=5440        <- host port published by docker-compose.override.yml
#
#    • Production (the API runs as a container on the internal Docker network):
#        POSTGRES_HOST=postgres    <- the compose SERVICE NAME, never a host port
#        POSTGRES_PORT=5432        <- the container's own internal port
POSTGRES_HOST=localhost
POSTGRES_PORT=5440
POSTGRES_USER=esaps_user
POSTGRES_PASSWORD=123456789
POSTGRES_DB=esaps_db
#  DATABASE_URL is the connection string Prisma uses (and the app, when set).
#  Prisma cannot assemble it from the parts above — it must be a literal string —
#  so the user/password/db written here MUST MATCH POSTGRES_USER/PASSWORD/DB above.
#  HOST side (this value): localhost:5440 — used by `prisma migrate` and a
#  host-run `npm run start:dev`. The backend CONTAINER does NOT use this line;
#  docker-compose.yml overrides it to ...@postgres:5432/... (internal service name).
DATABASE_URL=postgresql://esaps_user:123456789@localhost:5440/esaps_db

# ── Redis ────────────────────────────────────────────────────────────────────
#    • Development:  REDIS_HOST=localhost   REDIS_PORT=6385
#    • Production:   REDIS_HOST=redis       REDIS_PORT=6379   (internal service name)
REDIS_HOST=localhost
REDIS_PORT=6385
#  REDIS_PASSWORD must MATCH the password inside REDIS_URL below; it is also what
#  the redis container enforces via --requirepass. (Filled in beyond the requested
#  list because leaving it empty would break Redis AUTH — the container would run
#  without a password while the app's URL tries to authenticate.)
REDIS_PASSWORD=123456789
#  HOST side: localhost:6385. The backend CONTAINER does NOT use this line —
#  docker-compose.yml overrides it to redis://:...@redis:6379 (internal service name).
REDIS_URL=redis://:123456789@localhost:6385

# ── Field encryption (AES-256-GCM) ───────────────────────────────────────────
#  Two DIFFERENT 32-byte keys, each as 64 HEX characters.
#  Reusing one key for both weakens encryption and the lookup hash — keep separate.
#    generate:  openssl rand -hex 32
AES_KEY_HEX=2aa11ddeb07f468d869591ddb101cd2c76be6d7576cd5681cb47fb3f33f0f87b
SEARCH_HASH_KEY_HEX=acd946c89ab2fa0f231f493ebd80e9bdf72a68e589918020e74825ce96cb7ae8

# ── Barcode signing (HMAC-SHA256) ────────────────────────────────────────────
#  A barcode encodes ONLY the employee id, signed server-side with this secret.
#  Strong random value, >= 32 chars.
#    generate:  openssl rand -hex 32
BARCODE_HMAC_SECRET=da7f5f176f323d601e5b536a019f214ce2c6a36403a2577ba2e417e4e7e23f89

# ── JWT (RS256 — asymmetric signing) ─────────────────────────────────────────
#  RS256 uses an RSA key PAIR: the private key signs, the public key verifies.
#  Generate the pair:
#    openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-private.pem
#    openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
#
#  Provide each key EITHER inline (PEM with newlines escaped as \n) OR by file
#  path. If both are given for the same key, the inline value wins. Leave the
#  unused variant empty.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY_PATH=./jwt-private.pem
JWT_PUBLIC_KEY_PATH=./jwt-public.pem
#  Token lifetimes (e.g. 15m, 30d). NOTE: sessions never expire on a timer; these
#  only bound the access/refresh rotation window — logout is the real end-of-session.
JWT_ACCESS_TTL=12h
JWT_REFRESH_TTL=30d
JWT_ISSUER=
JWT_AUDIENCE=

# ── Seed (initial bootstrap accounts) ─────────────────────────────────────────
#  Replace each password with a strong value meeting the policy (>= 12 chars,
#  3 of 4 of lower/upper/digit/symbol, not common). Forced to change on first login.
SEED_SUPER_ADMIN_USERNAME=superadmin
SEED_SUPER_ADMIN_PASSWORD="Admin#Secure$2026!HQ"
SEED_BRANCH_HEAD_USERNAME=branch.head
SEED_BRANCH_HEAD_PASSWORD="Branch%Cmd*2026!Secure"
SEED_HR_USERNAME=hr.officer
SEED_HR_PASSWORD="HR$$Manager#Access%2026!Gate"
GATE_ACCESS_ENFORCED=false
