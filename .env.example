# =============================================================================
#  e-SAPS — environment TEMPLATE (.env.example)
#
#  Copy to ".env" and fill in real values:   cp .env.example .env
#  The real ".env" is git-ignored and must NEVER be committed.
#  Every value here is intentionally EMPTY — no secret lives in the repo.
#
#  Legend per variable:
#    [required]    must be set for the app/seed to run
#    [default: X]  optional — the code falls back to X when empty
#    (secret)      never commit a real value
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
#  Runtime mode. format: development | production | test       [default: development]
NODE_ENV=
#  HTTP port the API listens on. format: integer               [default: 3000]
PORT=
#  Human-readable app name (logs/metadata). format: free text  [default: e-SAPS]
APP_NAME=
#  Allowed browser origins for CORS. Comma-separated, e.g.
#  https://police.moi-sy.online,https://admin.example.com
#  LEAVE EMPTY in development — the Vite proxy makes the app same-origin (no CORS).
#  Set it only in production when the SPA is served from a different origin than the API.
CORS_ORIGINS=

# ── PostgreSQL ───────────────────────────────────────────────────────────────
#  Host + port are SEPARATE variables so the same build runs everywhere — only the
#  values change, never the code:
#    • Development (API on the host machine): POSTGRES_HOST=localhost  POSTGRES_PORT=5440
#    • Production  (API as a container):      POSTGRES_HOST=postgres   POSTGRES_PORT=5432
#
#  DB host. format: hostname / docker service name      [required unless DATABASE_URL set]
POSTGRES_HOST=
#  DB port. format: integer (5440 from host / 5432 inside the network)
POSTGRES_PORT=
#  DB role (login) name. format: identifier
POSTGRES_USER=
#  DB role password. format: text (secret)
POSTGRES_PASSWORD=
#  Database name. format: identifier
POSTGRES_DB=
#  Full connection string. Read directly by Prisma, and WINS over the five parts
#  above when set (so it must match POSTGRES_USER/PASSWORD/DB). In production the
#  host is the internal service name "postgres".
#  format: postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public   (secret — has password)
DATABASE_URL=

# ── Redis ────────────────────────────────────────────────────────────────────
#    • Development:  REDIS_HOST=localhost  REDIS_PORT=6385
#    • Production:   REDIS_HOST=redis      REDIS_PORT=6379  (internal service name)
#
#  Redis host. format: hostname / docker service name   [required unless REDIS_URL set]
REDIS_HOST=
#  Redis port. format: integer (6385 from host / 6379 internal)
REDIS_PORT=
#  Redis AUTH password; also what the container enforces via --requirepass.
#  format: text (secret)
REDIS_PASSWORD=
#  Full connection string. WINS over the parts above when set.
#  format: redis://:PASSWORD@HOST:PORT   (secret — has password)
REDIS_URL=

# ── Crypto keys ──────────────────────────────────────────────────────────────
#  AES-256-GCM key for encrypting sensitive fields (self_id, military_id, …) at rest.
#  format: 32 bytes = 64 hex chars (secret)  ·  generate: openssl rand -hex 32   [required]
AES_KEY_HEX=
#  Key for the deterministic HMAC search-hash used to look up encrypted columns.
#  MUST be different from AES_KEY_HEX.
#  format: 32 bytes = 64 hex chars (secret)  ·  generate: openssl rand -hex 32   [required]
SEARCH_HASH_KEY_HEX=
#  HMAC-SHA256 secret that signs employee barcodes (which encode the employee id only).
#  format: text, >= 32 chars (secret)  ·  generate: openssl rand -hex 32          [required]
BARCODE_HMAC_SECRET=

# ── JWT (RS256 — asymmetric) ─────────────────────────────────────────────────
#  RSA key PAIR: the private key signs, the public key verifies. Generate with:
#    openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-private.pem
#    openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
#  Provide EACH key inline OR by file path; inline wins if both are set.
#  [required: a private key (inline or path) AND a public key (inline or path)]
#
#  Private signing key, inline. format: PEM, newlines escaped as \n   (secret)
JWT_PRIVATE_KEY=
#  Public verify key, inline. format: PEM, newlines escaped as \n
JWT_PUBLIC_KEY=
#  Private signing key, by file. format: filesystem path (e.g. ./jwt-private.pem)   (secret)
JWT_PRIVATE_KEY_PATH=
#  Public verify key, by file. format: filesystem path (e.g. ./jwt-public.pem)
JWT_PUBLIC_KEY_PATH=
#  Access-token lifetime. format: duration string, e.g. 15m, 1h        [default: 15m]
JWT_ACCESS_TTL=
#  Refresh-token lifetime. format: duration string, e.g. 30d           [default: 30d]
#  (Sessions never expire on a timer; this only bounds token rotation.)
JWT_REFRESH_TTL=
#  Token "iss" (issuer) claim. format: string                          [default: e-saps]
JWT_ISSUER=
#  Token "aud" (audience) claim. format: string                        [default: e-saps-clients]
JWT_AUDIENCE=

# ── Seed accounts (initial bootstrap via `prisma db seed`) ────────────────────
#  Passwords for the three auto-created accounts. Each MUST meet the password policy
#  (>= 12 chars; 3 of 4 of lower/upper/digit/symbol; not a common password) or the
#  seed refuses to run. All three are forced to change their password on first login.
#
#  Super Admin username. format: identifier                       [default: superadmin]
SEED_SUPER_ADMIN_USERNAME=
#  Super Admin initial password. format: text meeting the policy (secret)  [required to seed]
SEED_SUPER_ADMIN_PASSWORD=
#  Branch Head username. format: identifier                       [default: branch.head]
SEED_BRANCH_HEAD_USERNAME=
#  Branch Head initial password. format: text meeting the policy (secret)  [required to seed]
SEED_BRANCH_HEAD_PASSWORD=
#  HR officer username. format: identifier                        [default: hr.officer]
SEED_HR_USERNAME=
#  HR officer initial password. format: text meeting the policy (secret)   [required to seed]
SEED_HR_PASSWORD=
