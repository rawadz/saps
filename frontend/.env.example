# Base URL the frontend uses for API calls.
# DEV: leave as '/api' — the Vite dev proxy forwards it to http://localhost:3000
#      (server-side), so there is no CORS and one Ngrok tunnel (port 5173) is enough.
# PROD (no dev proxy): set this to the backend's real URL, e.g.
#      VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=/api
